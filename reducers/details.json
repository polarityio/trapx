{
  "root": {
    "path": "",
    "on_null": "return_empty"
  },
  "pipeline": [
    {
      "op": "copy",
      "from": "events",
      "to": "reduced_results.events"
    },
    {
      "op": "project",
      "path": "reduced_results.events[]",
      "fields": [
        "severity",
        "attacker_ip",
        "event_name"
      ]
    },
    {
      "op": "prune",
      "strategy": "empty_values",
      "target": "reduced_results"
    }
  ],
  "output": {
    "result": "$working.reduced_results"
  }
}
